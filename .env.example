# Server-only Backend API URL (Proxied via Next.js rewrites; never exposed to client)
BACKEND_API_URL=https://dev.surplusmarket.com

# Optional: Multi-node Load Balancing Pool & Automatic Failover URLs (comma-separated)
# BACKEND_API_URLS=https://dev.surplusmarket.com,https://backup.surplusmarket.com
# FALLBACK_BACKEND_API_URL=https://backup.surplusmarket.com

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
